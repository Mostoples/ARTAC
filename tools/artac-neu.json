          "fontSize": 12,
          "color": "#FFFFFF",
          "y": -0.74
        },
        {
          "text": "Alarm eskalasi 5 tahap\n+ Video Observed Therapy",
          "start": 10.7,
          "duration": 2,
          "fontSize": 12,
          "color": "#FFFFFF",
          "y": -0.74
        },
        {
          "text": "Dokter & rumah sakit\npengendali utama",
